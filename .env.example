# LensGuide environment. Copy to .env and fill in.

# LLM_PROVIDER: gemini | openai | offline
LLM_PROVIDER=gemini

# Google Gemini (free tier). Get a key at https://aistudio.google.com/apikey
# gemini-3.6-flash is the current recommended model for new accounts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenAI-compatible endpoint (works with OpenAI, Ollama, LM Studio, Azure, Groq...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: path override to the PS-06 database (falls back to ./data/PS-06.db)
DATABASE_PATH=