# LensGuide environment. Copy to .env and fill in.

# LLM_PROVIDER: gemini | openai | mock | offline
LLM_PROVIDER=gemini

# Optional automatic fallback when the primary provider is rate-limited or
# unavailable. Set to openai after filling its credentials below.
LLM_FALLBACK_PROVIDER=
LLM_429_RETRIES=0
LLM_503_RETRIES=1
LLM_TIMEOUT_SECONDS=45
# Optional cache location; defaults to .cache/llm_cache.json.
LLM_CACHE_PATH=

# Google Gemini (free tier). Get a key at https://aistudio.google.com/apikey
# gemini-3.6-flash is the current recommended model for new accounts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional same-key model fallback; useful only if that model has quota.
GEMINI_FALLBACK_MODEL=

# OpenAI-compatible endpoint (works with OpenAI, Ollama, LM Studio, Azure, Groq...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Use text for LM Studio's OpenAI-compatible server; json_object for OpenAI.
OPENAI_RESPONSE_FORMAT=json_object

# LM Studio local vision setup (no paid API):
# LLM_PROVIDER=openai
# LLM_FALLBACK_PROVIDER=
# OPENAI_API_KEY=lm-studio
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_MODEL=qwen/qwen3.5-4b:fast
# OPENAI_RESPONSE_FORMAT=text
# Disable Qwen3.5's long reasoning pass for fast translation/OCR.
# OPENAI_DISABLE_THINKING=true
# OPENAI_MAX_TOKENS=512

# Optional: path override to the PS-06 database (falls back to ./data/PS-06.db)
DATABASE_PATH=