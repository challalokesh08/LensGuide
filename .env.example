# LensGuide environment. Copy to .env and fill in.

# LLM_PROVIDER: openai | gemini | offline
LLM_PROVIDER=offline

# OpenAI-compatible endpoint (works with OpenAI, Ollama, LM Studio, Azure, Groq...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (if using Google instead)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: path override to the PS-06 database (falls back to ./data/PS-06.db)
DATABASE_PATH=